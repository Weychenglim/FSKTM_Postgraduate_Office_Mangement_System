# ─────────────────────────────────────────────────────────────────────────────
# Django backend configuration for the FSKTM PG Office API.
#
# Copy this file to ".env" (in this backend/ folder) and fill in your values:
#     PowerShell:  Copy-Item .env.example .env
#     bash:        cp .env.example .env
#
# ".env" is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Django secret key. Generate any long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Development-only demo fixtures. Keep disabled and passwords blank in tracked
# configuration. Put local values in backend/.env only.
ENABLE_DEMO_ACCOUNTS=False
DEMO_ADMIN_PASSWORD=
DEMO_COORDINATOR_PASSWORD=
DEMO_LECTURER_PASSWORD=
DEMO_STUDENT_PASSWORD=
# Optional JSON object used once to preserve local user IDs when renaming fixtures.
DEMO_LEGACY_EMAIL_MAP=

# Where the React frontend runs — used to build the password-reset link.
FRONTEND_URL=http://localhost:3000

# Browsers allowed to call the API directly (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public authentication endpoint throttles. Development uses Django's local
# memory cache; configure a shared Redis-compatible cache before multi-worker
# production deployment.
AUTH_LOGIN_THROTTLE_RATE=10/minute
AUTH_PASSWORD_RESET_THROTTLE_RATE=5/hour
AUTH_PASSWORD_RESET_CONFIRM_THROTTLE_RATE=10/hour
# Keep zero unless the exact number of trusted reverse proxies is known.
DRF_NUM_PROXIES=0

# ── PostgreSQL (same database you set up for the project) ────────────────────
# NOTE: if you have more than one PostgreSQL version installed, the second one
# may listen on 5433 instead of 5432 — check yours.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=fsktm_pg_office

# ── Email (password-reset link) ─────────────────────────────────────────────
# Leave EMAIL_HOST_USER / EMAIL_HOST_PASSWORD BLANK to print the reset email
# (with the link) to the runserver console instead of sending it.
#
# To send real Gmail: enable 2-Step Verification on the Google account, then
# create an "App Password" (Google Account → Security → 2-Step Verification →
# App passwords) and paste the 16-character value below (no spaces).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FSKTM PG Office <no-reply@fsktm.edu.my>

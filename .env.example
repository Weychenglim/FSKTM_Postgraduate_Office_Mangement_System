# ─────────────────────────────────────────────────────────────────────────────
# Environment configuration for the FSKTM PG Office backend API.
#
# Copy this file to ".env" and fill in YOUR local values:
#     PowerShell:  Copy-Item .env.example .env
#     bash:        cp .env.example .env
#
# ".env" is gitignored on purpose — never commit real passwords.
# See DATABASE_SETUP.md for the full step-by-step.
# ─────────────────────────────────────────────────────────────────────────────

# Secret used to sign JWT login tokens. Any long random string works.
JWT_SECRET=change-me-to-a-long-random-string

# Port the Express API listens on.
API_PORT=4000

# ── PostgreSQL connection ───────────────────────────────────────────────────
# Host and port of your local PostgreSQL server.
# NOTE: if you installed more than one PostgreSQL version, the second one often
# listens on 5433 instead of 5432 — check yours before assuming 5432.
PGHOST=localhost
PGPORT=5432

# The PostgreSQL superuser created during installation (usually "postgres").
PGUSER=postgres

# The password YOU chose for that user when you installed PostgreSQL.
PGPASSWORD=your_postgres_password

# Name of the application database. `npm run db:setup` creates this for you —
# you do not need to create it manually.
PGDATABASE=fsktm_pg_office

# Frontend API configuration.
# Keep mocks enabled while backend endpoints are not ready.
VITE_API_BASE_URL="/api"
VITE_USE_MOCKS="true"
VITE_MOCK_LATENCY_MS="500"
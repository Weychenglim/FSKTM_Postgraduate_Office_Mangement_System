# Frontend environment configuration.
#
# Copy to ".env" only when you need to override these defaults locally.
# Vite exposes only variables prefixed with VITE_ to browser code.

# Development-only login prefills. Keep disabled and passwords blank in this
# tracked template. Put local values in frontend/.env.development.local only.
VITE_ENABLE_DEMO_LOGIN="false"
VITE_DEMO_ADMIN_PASSWORD=""
VITE_DEMO_COORDINATOR_PASSWORD=""
VITE_DEMO_LECTURER_PASSWORD=""
VITE_DEMO_STUDENT_PASSWORD=""

# API base path used by frontend services. Keep /api for same-origin production.
VITE_API_BASE_URL="/api"

# Keep mock mode enabled for modules that do not have matching backend endpoints yet.
VITE_USE_MOCKS="true"

# Lecturer-side panel appointment workflow has backend persistence now.
# Leave this true to make panel recommendations survive refresh.
VITE_USE_PANEL_BACKEND="true"

# Supervisor appointment applications and decisions persist in Django.
VITE_USE_SUPERVISOR_BACKEND="true"

# Lecturer mark drafts/submissions and rubric data persist in Django.
VITE_USE_MARKS_BACKEND="true"

# Office-staff dashboard timeline management has backend persistence now.
# Leave this true so timeline schedule, entries, upload, add/edit/delete, and audit logs use Django.
VITE_USE_TIMELINE_BACKEND="true"

# Simulated response delay for mock-backed services.
VITE_MOCK_LATENCY_MS="500"

upstream fsktm_django {
    server django:8000;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name portal.example.test;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name portal.example.test;

    ssl_certificate /etc/letsencrypt/live/portal.example.test/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal.example.test/privkey.pem;

    root /srv/fsktm/frontend/dist;
    index index.html;
    client_max_body_size 12m;

    add_header Strict-Transport-Security "max-age=3600" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;

    # Start here. Switch this include to csp-enforced.conf only after the
    # report-only browser smoke is clean.
    include /etc/nginx/fsktm/csp-report-only.conf;

    location ~* \.map$ {
        return 404;
        access_log off;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    location /static/ {
        alias /srv/fsktm/backend/staticfiles/;
        expires 7d;
    }

    location /api/ {
        proxy_pass http://fsktm_django;
        proxy_hide_header Strict-Transport-Security;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    location = /admin {
        return 301 /admin/;
    }

    location /admin/ {
        proxy_pass http://fsktm_django;
        proxy_hide_header Strict-Transport-Security;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
